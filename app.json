{
  "expo": {
    "name": "NOSHE 2026",
    "slug": "noshe-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/logo-1.png",
      "resizeMode": "contain",
      "backgroundColor": "#004EA8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#004EA8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "react-native-bottom-tabs"
    ]
  }
}
